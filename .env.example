# Recovery Toolkit settings. Copy this file to ".env" (same folder) and fill it in.
# .env is in .gitignore: passwords and keys never go into git.
# Real environment variables with the same name override values in this file.
# Relative paths are relative to the folder of the .env file.

# ---------------------------------------------------------------- catalog database
# sqlite    = one local file (default; nothing to install)
# sqlserver = SQL Server / LocalDB / Express, e.g. one shared catalog for several PCs
DB_PROVIDER=sqlite
DB_CONNECTION=Data Source=catalog.db

# SQL Server examples (the database is created automatically if it does not exist):
#   Windows login (LocalDB comes with Visual Studio):
# DB_PROVIDER=sqlserver
# DB_CONNECTION="Server=(localdb)\MSSQLLocalDB;Database=RecoveryCatalog;Trusted_Connection=True;TrustServerCertificate=True"
#   SQL login, password kept separate and inserted with ${...}:
# DB_PASSWORD=change-me
# DB_CONNECTION="Server=nas01;Database=RecoveryCatalog;User ID=rt;Password=${DB_PASSWORD};Encrypt=True"

# ---------------------------------------------------------------- files
DICTIONARIES_FILE=config/dictionaries.xml
# LOG_DIR=logs            # default: %LOCALAPPDATA%\RecoveryToolkit\logs

# ---------------------------------------------------------------- network export (phase 9, not used yet)
# NET_PROTOCOL=sftp                  # sftp (recommended) or ftp (FTPS when the server supports it)
# NET_HOST=nas01.local
# NET_PORT=22
# NET_USER=recovery
# NET_PASSWORD=                      # only if no key is used
# NET_PRIVATE_KEY=keys/id_ed25519    # SSH private key (public key goes on the server); keys/ is git-ignored
# NET_PRIVATE_KEY_PASSPHRASE=
# NET_HOST_KEY_FINGERPRINT=SHA256:... # pin the server key: refuse to upload if it changes
# NET_REMOTE_DIR=/recovered
# BACKLOG_DIR=D:/_Backlog            # filled by the recovery process only
# OVERRIDE_DIR=D:/_Override          # uploaded / duplicate / unrecoverable files: space can be reclaimed here
