<Project Sdk="Microsoft.NET.Sdk">

  <!-- Business Logic Layer: domain models, DTOs, repository/data-source interfaces, services.
       References no database or UI technology; the DAL implements its interfaces (dependency inversion). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RecoveryBLL</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecoveryBLL.Tests" />
  </ItemGroup>

</Project>
